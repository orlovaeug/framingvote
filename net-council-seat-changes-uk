<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;font-size:12px;color:#888780;">
  <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;border-radius:2px;background:#1D9E75;"></span>Gains</span>
  <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;border-radius:2px;background:#D85A30;"></span>Losses</span>
</div>
<div style="position:relative;width:100%;height:220px;">
  <canvas id="chart2" role="img" aria-label="Net seat changes in 2026 UK local elections: Reform UK +1300, Lib Dems +120, Greens +95, Conservatives -300, Labour -1000">Reform UK +1300, Lib Dems +120, Greens +95, Conservatives -300, Labour -1000.</canvas>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
new Chart(document.getElementById('chart2'), {
  type: 'bar',
  data: {
    labels: ['Reform UK','Lib Dems','Greens','Conservative','Labour'],
    datasets: [{
      label: 'Net seat change',
      data: [1300, 120, 95, -300, -1000],
      backgroundColor: ['#1D9E75','#7F77DD','#639922','#D85A30','#D85A30'],
      borderWidth: 0,
      borderRadius: 4
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y > 0 ? '+' : ''}${ctx.parsed.y} seats` } }
    },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#888780', font: { size: 12 } } },
      y: {
        grid: { color: 'rgba(136,135,128,0.15)' },
        ticks: {
          color: '#888780', font: { size: 11 },
          callback: v => (v > 0 ? '+' : '') + v
        }
      }
    }
  }
});
</script>
